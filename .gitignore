# ============ 依赖与构建产物 ============
node_modules/
dist/
dist-*/
out/
.DS_Store
Thumbs.db
desktop.ini

# ============ 运行时数据（本地状态，绝不上传）============
# data/ 里是游戏安装注册表、下载队列、下载回来的 7GB+ 压缩包、备份、日志
data/
_dl/

# ============ 开发期截图 / 探针日志 ============
_shots/*.png
_shots/*.log
_shots/*.txt
*.log

# ============ 本地工具与编辑器 ============
.idea/
.vscode/
*.swp
*~

# ============ 其它临时文件 ============
*.tmp
*.part
.cache/

# ============ i18n 开发期中间产物 ============
# 语言包备份、翻译暂存、抽取的原始键表、待办清单 —— 都能由 _probe/ 下脚本重新生成
_probe/_locales-backup*/
_probe/_new-keys.json
_probe/_todo.json
_probe/i18n-keys.json.bak
_probe/*.bak
_probe/*.json.bak
# 全量测试汇总产物（每次跑都会重写，不进仓库）
_probe/_run-all-result.json

# ============ 纯 Node 环境下的 userData 回落目录 ============
.userdata/

# 说明：.workbuddy-ai/ 与 .workbuddy/ 是 AI 助手的项目级记忆与 skill，含本机绝对路径与工作日志，
# 不随仓库发布（想公开其中的经验总结，请先人工删掉机器相关路径再放开这两行）
.workbuddy-ai/
.workbuddy/
